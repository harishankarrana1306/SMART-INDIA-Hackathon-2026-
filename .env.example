# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crime_network
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/crime_network
DATABASE_SYNC_URL=postgresql://postgres:postgres@postgres:5432/crime_network

# Neo4j Configuration
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword
NEO4J_AUTH=neo4j/neo4jpassword

# Security & JWT
JWT_SECRET=supersecret-dev-jwt-key-sih-2026-ncrb-investigator-tool
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Application Environment
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Frontend Base URL
VITE_API_BASE_URL=http://localhost:8000
